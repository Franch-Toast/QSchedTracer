# ============================================
# QNX Scheduler Tracer - Git Ignore
# ============================================

# ============================================
# 编译输出
# ============================================
build/
build_*/
cmake_build/
*.o
*.a
*.so
*.so.*
dist/

# Bazel
bazel-bin
bazel-out
bazel-testlogs
bazel-QSchedTracer
MODULE.bazel.lock

# kev_parser bundled deps (libtraceparser.a 是项目依赖，需要提交)
!kev_parser/deps/
!kev_parser/deps/**
!kev_parser/deps/**/*.a

.cache/
__pycache__/

docs/

# 可执行文件
qst_demo
qst_parse

# ============================================
# 运行时产生的文件和配置文件
# ============================================
# Trace 数据文件
*.qst
*.bin
sched_trace.bin

# Chrome/Perfetto 格式输出
*.json
trace.json
*.perfetto

!config/*.json

# Core dump 文件
*.core
core.*

# 临时的文件和目录
build_executable.sh
qst_parser_entry.py
qst_parser.spec

# ============================================
# IDE 和编辑器
# ============================================
# VSCode
.vscode/
*.code-workspace

# CLion / IntelliJ
.idea/
*.iml
cmake-build-*/

# Eclipse
.project
.cproject
.settings/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.*.swp
Session.vim

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# ============================================
# 操作系统
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*.directory

# ============================================
# Python (qst_parse.py)
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.mypy_cache/
.pytest_cache/

# ============================================
# 日志文件
# ============================================
log/
*.log
logs/

# ============================================
# 临时文件
# ============================================
*.tmp
*.temp
*.bak
*.backup
tmp/
temp/

# ============================================
# 文档生成
